[Unit]
Description=assert backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/git/assert/backend
EnvironmentFile=-/etc/assert/env
Environment=ASSERT_REPO_ROOT=/root/git/assert
ExecStart=/root/git/assert/backend/.venv/bin/uvicorn \
    assert_app.app:app \
    --host 127.0.0.1 \
    --port 18400 \
    --log-level info
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
